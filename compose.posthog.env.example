# compose.posthog.env.example — reference keys for the self-hosted PostHog stack.
#
# These are the .env keys compose.posthog.yml reads. They are ISOLATED from the
# OEE stack's .env (see .env.example / app_init.sh). At bring-up on the PostHog
# box, write these into that box's /opt/packiot/.env (or a dedicated
# /opt/posthog/.env you pass with `--env-file`).
#
# ⚠ NEVER commit real values. The credential-bearing keys below live in AWS
# Secrets Manager under `packiot/production/posthog` (declared in
# terraform/production/secrets.tf). See docs/posthog-selfhost-runbook.md for how
# they reach .env (the ONBOARD_API_KEY / OAUTH2_PROXY_* precedent).

# ─── Pinned versions ──────────────────────────────────────────────────────────
# App image tag. Pinned to the classic self-host release (see compose header).
POSTHOG_APP_TAG=release-1.43.0
# ClickHouse image (optional override; default matches the pinned release).
# POSTHOG_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:22.3

# ─── Upstream checkout for ClickHouse config/init (bring-up step) ─────────────
# Path to the pinned PostHog repo checkout the clickhouse service mounts config +
# schema + idl from. Default ./posthog (clone it next to compose.posthog.yml):
#   git clone --branch release-1.43.0 --depth 1 https://github.com/PostHog/posthog.git posthog
# POSTHOG_SRC=./posthog

# ─── Public URL (must equal the reverse-proxy vhost) ──────────────────────────
# front4's VITE_POSTHOG_HOST target. Covered by the *.prod.packiot.app wildcard cert.
POSTHOG_SITE_URL=https://e.prod.packiot.app

# ─── SECRET: Django secret key (SECRETS MANAGER) ──────────────────────────────
# Stable across restarts (rotating invalidates sessions + encrypted fields).
# Generate: openssl rand -hex 32
POSTHOG_SECRET=

# ─── PostHog metadata Postgres (DEDICATED — not the OEE r7g) ──────────────────
POSTHOG_POSTGRES_USER=posthog
POSTHOG_POSTGRES_DB=posthog
# SECRET (Secrets Manager). Generate: openssl rand -hex 24
POSTHOG_POSTGRES_PASSWORD=

# ─── Object storage / minio (session recordings + exports) ────────────────────
POSTHOG_OBJECT_STORAGE_ACCESS_KEY_ID=object_storage_root_user
# SECRET (Secrets Manager). Generate: openssl rand -hex 24
POSTHOG_OBJECT_STORAGE_SECRET_ACCESS_KEY=

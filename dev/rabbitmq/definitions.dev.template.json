      "destination": "stream-engine-q-sbxcpack",
      "destination_type": "queue",
      "routing_key": "sparkplug.data.sbxcpack",
      "arguments": {}
    },
    {
      "source": "oee-retry",
      "vhost": "/",
      "destination": "stream-engine-q-sbxcpack-retry-30s",
      "destination_type": "queue",
      "routing_key": "sparkplug.data.sbxcpack",
      "arguments": {}
    },
    {
      "source": "oee-failed",
      "vhost": "/",
      "destination": "stream-engine-q-sbxcpack-failed",
      "destination_type": "queue",
      "routing_key": "sparkplug.data.sbxcpack",
      "arguments": {}
    },
    {

# dev/.env.dev — local development environment (ADR-0060 D1/D3).
#
# CHECKED IN ON PURPOSE. Every value here is a FAKE, dev-only credential that
# guards nothing but containers bound to 127.0.0.1 on a developer laptop.
# NEVER put a real secret here (no staging/prod password, no AWS key, no token).
# Override per-laptop with shell env vars (`POSTGRES_PASSWORD=x make dev`):
# shell env wins over --env-file.
#
# Constraint: the RabbitMQ values below are spliced into the definitions file
# with sed (dev/rabbitmq/render-definitions.sh); keep them to [A-Za-z0-9._-].

# ── Postgres (Tier 0) ────────────────────────────────────────────────────────
# P1-B's seed image replaces this via DEVDB_IMAGE. Staging runs PG 15.17 +
# TimescaleDB 2.27.0 (docs/dev/contracts.md §5).
DEVDB_IMAGE=timescale/timescaledb:2.27.0-pg15
POSTGRES_USER=postgres
POSTGRES_PASSWORD=packiot-dev
POSTGRES_DB=packiot_analytics

# ── RabbitMQ (Tier 0) ────────────────────────────────────────────────────────
# Same three users as staging's monitoring/rabbitmq/definitions.template.json.
RABBITMQ_USER=packiot-dev
RABBITMQ_PASSWORD=packiot-dev
RABBITMQ_STREAM_ENGINE_PASSWORD=stream-engine-dev
RABBITMQ_SPARKPLUG_DECODER_PASSWORD=sparkplug-decoder-dev

# ── MinIO (Tier 0, stands in for S3) ─────────────────────────────────────────
# Image: upstream minio/minio was removed from Docker Hub (404) and
# quay.io/minio is auth-gated, so dev uses the pgsty community build of the
# same MinIO server. Swap here if you have a preferred S3-compatible image.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MINIO_ROOT_USER=packiot-dev
MINIO_ROOT_PASSWORD=packiot-dev-minio
# Staging's bucket is packiot-staging-historian-<account_id>
# (terraform/staging/historian.tf); services read it from HISTORIAN_BUCKET.
HISTORIAN_BUCKET=packiot-dev-historian

# ── Grafana (Tier 4 slice) ───────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── Host ports (always bound to 127.0.0.1; change only on a clash) ───────────
DEV_PG_PORT=5432
DEV_RABBITMQ_PORT=5672
DEV_RABBITMQ_MGMT_PORT=15672
DEV_MQTT_PORT=1883
DEV_REDIS_PORT=6379
DEV_MINIO_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
DEV_GRAFANA_PORT=3000

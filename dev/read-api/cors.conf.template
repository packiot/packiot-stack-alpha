# Dev twin of staging's refdata vhost CORS (terraform/staging/user_data/nginx_setup.sh, "refdata vhost").
# The preflight must not reach read-api's fail-closed auth: answer OPTIONS with 204 here. `always` keeps
# the ACAO header on read-api's 401/4xx so the browser can read error bodies. ${DEV_CORS_ORIGIN} is
# substituted by the nginx image's envsubst at start.
server {
    listen 80;
    location / {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "${DEV_CORS_ORIGIN}" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization, X-Api-Key, Content-Type, x-packiot-agent, x-user, x-operator-superadmin-token" always;
            add_header Access-Control-Max-Age      86400 always;
            add_header Content-Length 0;
            add_header Content-Type "text/plain";
            return 204;
        }
        add_header Access-Control-Allow-Origin  "${DEV_CORS_ORIGIN}" always;
        add_header Access-Control-Allow-Headers "Authorization, X-Api-Key, Content-Type, x-packiot-agent, x-user, x-operator-superadmin-token" always;
        proxy_pass         http://read-api:9104;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }
}

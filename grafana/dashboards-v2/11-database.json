{
  "uid": "v2-database",
  "title": "v2 · Database (Postgres / TimescaleDB)",
  "tags": ["packiot-v2", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
        "query": { "query": "label_values(pg_database_size_size_bytes, datname)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "packiot_shadow", "value": "packiot_shadow" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "### Database — Postgres + TimescaleDB (packiot F1/F2 · packiot_shadow F3)\nWhite-box metrics from postgres-exporter's custom `queries.yaml` (connections by state, cache hit, locks, long queries, tuple/deadlock rates, table + hypertable sizes). Custom metric names follow `{query}_{column}`. Health-zeros (0 deadlocks, 0 waiting locks) are the target." }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Postgres up",
      "description": "pg_up per database. 1 = reachable.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["min"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "pg_up", "legendFormat": "{{server}}", "refId": "A" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "pg_cache_hit_hit_ratio — buffer-cache hits / (hits + disk reads). Below ~0.98 sustained = memory pressure or a cold/heavy scan.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.98 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value_and_name" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "pg_cache_hit_hit_ratio{datname=~\"$datname\"}", "legendFormat": "{{datname}}", "refId": "A" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Longest active query",
      "description": "pg_longest_query_longest_active_seconds — age of the longest currently-running statement. A climbing value = a stuck/heavy query.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 300 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "max(pg_longest_query_longest_active_seconds{datname=~\"$datname\"})", "refId": "A" } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Longest idle-in-transaction",
      "description": "pg_longest_query_longest_idle_in_txn_seconds — the classic lock-holder / bloat cause. Should stay low.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 3 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 120 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["max"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "max(pg_longest_query_longest_idle_in_txn_seconds{datname=~\"$datname\"})", "refId": "A" } ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connections by state",
      "description": "pg_activity_by_state_connections. Watch 'idle in transaction' — a sustained climb is a connection leak / un-closed txn.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 12, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byName", "options": "idle in transaction" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (state) (pg_activity_by_state_connections{datname=~\"$datname\"})", "legendFormat": "{{state}}", "refId": "A" } ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Transaction rate (commit vs rollback)",
      "description": "rate(pg_db_activity_xact_commit[5m]) vs rollback. A rollback spike = errors upstream.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*rollback.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (datname) (rate(pg_db_activity_xact_commit{datname=~\"$datname\"}[5m]))", "legendFormat": "{{datname}} commit", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (datname) (rate(pg_db_activity_xact_rollback{datname=~\"$datname\"}[5m]))", "legendFormat": "{{datname}} rollback", "refId": "B" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Locks waiting by mode (contention — flat 0 healthy)",
      "description": "pg_locks_by_mode_waiting. Any sustained non-zero = backends blocked waiting on a lock.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (mode) (pg_locks_by_mode_waiting)", "legendFormat": "{{mode}}", "refId": "A" } ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Deadlocks + temp-file spills (rate)",
      "description": "rate(pg_db_activity_deadlocks[5m]) and rate(pg_db_activity_temp_bytes[5m]). Deadlocks should be flat 0; temp bytes = work_mem spills.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "auto" } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*temp.*" }, "properties": [ { "id": "unit", "value": "Bps" }, { "id": "custom.axisPlacement", "value": "right" } ] }, { "matcher": { "id": "byRegexp", "options": ".*deadlock.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (datname) (rate(pg_db_activity_deadlocks{datname=~\"$datname\"}[5m]))", "legendFormat": "{{datname}} deadlocks", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (datname) (rate(pg_db_activity_temp_bytes{datname=~\"$datname\"}[5m]))", "legendFormat": "{{datname}} temp", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database size on disk",
      "description": "pg_database_size_size_bytes per database.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "pg_database_size_size_bytes{datname=~\"$datname\"}", "legendFormat": "{{datname}}", "refId": "A" } ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top tables by total size",
      "description": "pg_table_size_top_total_bytes — biggest relations (heap + indexes + TOAST), with dead-tuple bloat. Scoped to the $datname variable (defaults to the F3 plane packiot_shadow; legacy packiot selectable). The exporter emits a per-DB datname label.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" }, "unit": "bytes" }, "overrides": [ { "matcher": { "id": "byName", "options": "dead_tuples" }, "properties": [ { "id": "unit", "value": "short" } ] }, { "matcher": { "id": "byName", "options": "live_tuples" }, "properties": [ { "id": "unit", "value": "short" } ] } ] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [ { "displayName": "total_bytes", "desc": true } ] },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "topk(20, pg_table_size_top_total_bytes{datname=~\"$datname\"})", "format": "table", "instant": true, "refId": "A" } ],
      "transformations": [ { "id": "filterFieldsByName", "options": { "include": { "names": ["datname", "schema", "table", "Value"] } } }, { "id": "organize", "options": { "renameByName": { "Value": "total_bytes" } } } ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "TimescaleDB hypertables (size + chunks + compression)",
      "description": "pg_timescaledb_hypertables_* — hypertable total size, chunk count, and whether compression is enabled. Scoped to $datname (default F3 packiot_shadow), public schema — the join key is the hypertable name, so scoping to one DB + schema avoids cross-DB/cross-schema name clashes (keep $datname single-valued for the join). Empty on plain-Postgres DBs (guarded query).",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" }, "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [ { "displayName": "total_bytes", "desc": true } ] },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "pg_timescaledb_hypertables_total_bytes{datname=~\"$datname\", schema=\"public\"}", "format": "table", "instant": true, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "pg_timescaledb_hypertables_num_chunks{datname=~\"$datname\", schema=\"public\"}", "format": "table", "instant": true, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "pg_timescaledb_hypertables_compression_enabled{datname=~\"$datname\", schema=\"public\"}", "format": "table", "instant": true, "refId": "C" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "hypertable", "mode": "outer" } },
        { "id": "filterFieldsByName", "options": { "include": { "names": ["hypertable", "schema 1", "Value #A", "Value #B", "Value #C" ] } } },
        { "id": "organize", "options": { "renameByName": { "schema 1": "schema", "Value #A": "total_bytes", "Value #B": "chunks", "Value #C": "compressed" } } }
      ]
    }
  ]
}

{
  "uid": "packiot-pipeline-logs",
  "title": "PLC Pipeline Logs",
  "tags": [
    "packiot",
    "logs",
    "pipeline"
  ],
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "packiot-loki"
        },
        "query": {
          "type": "labelValues",
          "label": "service"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {}
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": {
          "value": ""
        },
        "query": ""
      }
    ]
  },
  "links": [
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "type": "link",
      "title": "OEE Pipeline",
      "url": "/d/oee-pipeline",
      "tooltip": "OEE Pipeline \u2014 Live Monitor"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "type": "link",
      "title": "Equipment Config",
      "url": "/d/equipment-config",
      "tooltip": "Equipment & PackML Routing"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "type": "link",
      "title": "System Health",
      "url": "/d/system-health",
      "tooltip": "System Health \u2014 DB & Pipeline"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "type": "link",
      "title": "Stack Overview",
      "url": "/d/packiot-logs",
      "tooltip": "Stack Overview \u2014 log volumes & pipeline health"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "type": "link",
      "title": "Operator Activity",
      "url": "/d/packiot-operator",
      "tooltip": "Operator Activity \u2014 per-user actions & downtimes"
    },
    {
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "type": "link",
      "title": "Services Logs",
      "url": "/d/packiot-services-logs",
      "tooltip": "Services Logs \u2014 edge-api, operator, simulator"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "edge-nodered",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "packiot-loki"
          },
          "expr": "{service=\"edge-nodered\"} |~ \"$search\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "oeecloud",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "packiot-loki"
          },
          "expr": "{service=\"oeecloud\"} |~ \"$search\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "edge-nodered \u2192 AMQP (writes/min by machine)",
      "description": "equipment_values rows written per minute per machine \u2014 proxy for messages published from edge-nodered through RabbitMQ to oeecloud.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "gradientMode": "opacity"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "packiot-postgres"
          },
          "rawSql": "SELECT time_bucket('1 minute', ev.ts_value) AS time, split_part(pr.packml_topic, '/', -1) AS metric, COUNT(*) AS value FROM equipment_values ev JOIN packml_register pr ON pr.id_equipment = ev.id_equipment WHERE $__timeFilter(ev.ts_value) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "oeecloud \u2190 AMQP (PO starts/min)",
      "description": "production_orders_runtime rows per minute \u2014 measures PO lifecycle events driven by the AMQP pipeline through oeecloud.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "spanNulls": false,
            "gradientMode": "none"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "packiot-postgres"
          },
          "rawSql": "SELECT time_bucket('1 minute', lower(runtime_timerange)) AS time, COUNT(*) AS \"PO events\" FROM production_orders_runtime WHERE $__timeFilter(lower(runtime_timerange)) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Recent Pipeline Messages (last 20 equipment_values)",
      "description": "Most recent rows written to equipment_values by oeecloud \u2014 shows the actual data flowing through the AMQP pipeline.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "sortBy": [
          {
            "desc": true,
            "displayName": "ts_value"
          }
        ],
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "packiot-postgres"
          },
          "rawSql": "SELECT ev.ts_value, split_part(pr.packml_topic, '/', -1) AS machine, ev.state, ev.speed, ev.net_production_incr, ev.gross_production_incr FROM equipment_values ev JOIN packml_register pr ON pr.id_equipment = ev.id_equipment ORDER BY ev.ts_value DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ]
}
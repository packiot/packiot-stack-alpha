{
  "title": "08 \u2014 oeecloud-worker: AMQP in \u2192 engine \u2192 writes per flow",
  "uid": "oeecloud-worker-flow",
  "tags": [
    "flow"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "IN \u2014 AMQP deliveries (sparkplug.data envelopes)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Deliveries by outcome (per min)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (result)(rate(oeecloud_worker_amqp_deliveries_total[5m]))*60",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "description": "acked = written \u00b7 nacked_retry = transient failure \u00b7 exhausted_failed = dropped to oee-failed"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Handler latency p50 / p95 / p99",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le)(rate(oeecloud_worker_handler_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(oeecloud_worker_handler_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(oeecloud_worker_handler_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "ENGINE \u2014 scheduled jobs (rollups, UNS, reports, bake)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job ticks by outcome (10m window) \u2014 everything should be job/ok",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job, outcome)(increase(oeecloud_worker_job_ticks_total[10m]))",
          "legendFormat": "{{job}}/{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "OUT \u2014 statements written per destination flow",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Batch writes by destination (per min) \u2014 f1/f2/f3 must track each other",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (dest)(rate(oeecloud_worker_batch_writes_total{result=\"ok\"}[5m]))*60",
          "legendFormat": "{{dest}}",
          "refId": "A"
        }
      ],
      "description": "Each envelope routes by source_type: f1_public (packiot.public) \u00b7 f2_shadow_go_port (schema) \u00b7 f3_packiot_shadow (refactored DB)"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Write errors (1h) \u2014 any non-zero needs a look",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(oeecloud_worker_batch_writes_total{result=\"error\"}[1h])) or vector(0)",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "PO control (30800s lifecycle commands, shadow paths)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "PO control ops (per 10m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (op)(increase(oeecloud_worker_po_control_ops_total[10m]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PO parameter writer ops (per 10m)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (op)(increase(oeecloud_worker_writer_po_parameter_ops_total[10m]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ]
    }
  ]
}
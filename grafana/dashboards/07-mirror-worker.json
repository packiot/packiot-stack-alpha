    {
      "id": 8,
      "type": "timeseries",
      "title": "DLQ depth (EMPTY = healthy) + reanimated",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "mirror_worker_dlq_depth",
          "legendFormat": "depth",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(increase(mirror_worker_dlq_reanimated_total[1h]))",

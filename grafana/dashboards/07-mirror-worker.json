{
  "title": "07 \u2014 mirror-worker: prod in \u2192 replay/fan-out out",
  "uid": "mirror-worker-flow",
  "tags": [
    "flow",
    "retires-at-flip"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "IN \u2014 from PROD (SELECT-only, always)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "user_logs polled vs replayed (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(rate(mirror_worker_user_logs_polled_total[5m]))*60",
          "legendFormat": "polled",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(rate(mirror_worker_user_logs_replayed_total[5m]))*60",
          "legendFormat": "replayed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Cursor lag behind prod",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "mirror_worker_cursor_lag_seconds",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reconciler: events + POs + values synced (per tick)",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(increase(mirror_worker_reconciler_events_total[10m]))",
          "legendFormat": "events",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(increase(mirror_worker_reconciler_pos_total[10m]))",
          "legendFormat": "POs",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(increase(mirror_worker_reconciler_values_synced_total[10m]))",
          "legendFormat": "value deltas",
          "refId": "C"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "OUT \u2014 to the three staging flows",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Value fan-out by destination (per min, ok)",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 55,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum by (destination)(rate(mirror_worker_value_fanout_total{outcome=\"ok\"}[5m]))*60",
          "legendFormat": "{{destination}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Fan-out failures (must stay 0)",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "(sum(rate(mirror_worker_value_fanout_total{outcome!=\"ok\"}[10m])) or vector(0))*60",
          "legendFormat": "fanout failures",
          "refId": "A"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "HEALTH \u2014 comparator watchdog + DLQ",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Comparator: OEE divergence % per active PO",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0,
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "mirror_worker_comparator_oee_divergence_pct",
          "legendFormat": "{{po}}",
          "refId": "A"

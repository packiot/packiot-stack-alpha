      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Active-POs diff + events lag",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "mirror_worker_comparator_active_pos_diff",
          "legendFormat": "PO diff",

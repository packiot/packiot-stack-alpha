    {
      "id": 1,
      "type": "timeseries",
      "title": "MQTT messages received / handled / dropped (per min)",
      "datasource": {
        "type": "prometheus",
        "uid": "packiot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(rate(edge_transformer_mqtt_received_total[5m]))*60",
          "legendFormat": "received",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "packiot-prometheus"
          },
          "expr": "sum(rate(edge_transformer_mqtt_handled_total[5m]))*60",

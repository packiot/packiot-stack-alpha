{
  "uid": "v2-overview",
  "title": "v2 · Overview",
  "tags": ["packiot-v2", "overview"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Firing alerts",
      "description": "ALERTS{alertstate=\"firing\"}. Empty = nothing firing (healthy). Driven by monitoring/prometheus/rules.yml.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "alertname", "desc": false }] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "filterFieldsByName", "options": { "include": { "names": ["alertname", "severity", "job", "surface", "tenant", "Value"] } } }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "MQTT connected",
      "description": "edge-transformer's broker link. 1 = connected.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "max(edge_transformer_mqtt_connected)", "refId": "A" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Postgres up",
      "description": "pg_up across both databases (packiot + packiot_shadow).",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["min"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "min(pg_up)", "refId": "A" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Outbox depth",
      "description": "edge-transformer outbox rows awaiting drain. Near 0 = healthy; a climb = downstream backing up.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "max(outbox_depth)", "refId": "A" } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Mirror cursor lag",
      "description": "mirror_worker_cursor_lag_seconds — how far replay is behind prod.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 120 }, { "color": "red", "value": 600 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "max(mirror_worker_cursor_lag_seconds)", "refId": "A" } ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "DLQ depth",
      "description": "mirror_worker_dlq_depth — replay dead-letters awaiting retry. 0 = healthy.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 25 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "max(mirror_worker_dlq_depth)", "refId": "A" } ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Does data land? — engine write rate",
      "description": "sum rate(oeecloud_worker_batch_writes_total{result=\"ok\"}[5m]). Rows/s the engine commits; flat 0 while MQTT is up = the write path is broken.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "wps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum (rate(oeecloud_worker_batch_writes_total{result=\"ok\"}[5m]))", "legendFormat": "written/s", "refId": "A" } ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job ticks by outcome (ok vs error/panic)",
      "description": "sum by(outcome) rate(oeecloud_worker_job_ticks_total[5m]). error/panic lines should stay flat 0.",
      "datasource": { "type": "prometheus", "uid": "packiot-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [ { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "packiot-prometheus" }, "expr": "sum by (outcome) (rate(oeecloud_worker_job_ticks_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" } ]
    }
  ]
}

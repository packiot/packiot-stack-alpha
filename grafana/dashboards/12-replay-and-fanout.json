              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS go_unresolved FROM shadow_go_port.equipment_values s JOIN public.equipment_values p USING (ts_value, id_equipment) WHERE s.ts_value > now() - interval '24 hours' AND s.ts_value_production IS NOT NULL AND s.id_shift IS NULL AND p.id_shift IS NOT NULL"
        }

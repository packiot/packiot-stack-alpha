# legacy-replicator — cross-instance twin replicator (sibling of analytics-sync).
# Shares the module; builds the ./cmd/legacy-replicator entrypoint.
FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download 2>/dev/null || true
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' \
    -o /out/legacy-replicator ./cmd/legacy-replicator

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/legacy-replicator /usr/local/bin/legacy-replicator
EXPOSE 9104
ENTRYPOINT ["/usr/local/bin/legacy-replicator"]

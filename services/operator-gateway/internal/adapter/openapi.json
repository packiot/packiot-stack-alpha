  "components": {
    "securitySchemes": {
      "ingestKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Ingest-Key",
        "description": "Shared key for the client's tee node (OPERATOR_API_KEY), compared in constant time. An unset key on the server denies every request."
      }
    },
    "responses": {
      "Accepted": {
        "description": "edge-api accepted the call (2xx).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "const": "accepted"
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "`invalid JSON body` (malformed JSON, a wrongly typed field, an `id_order` that is neither string nor number, or a body over 1 MiB).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "`invalid or missing X-Ingest-Key`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "`action is not scoped to the configured Incoplast enterprise`: `enterprise` / `packml_topic` do not positively match the configured tenant.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "`method not allowed`: only POST is accepted.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "`packml_topic` missing or not resolvable to exactly one active equipment of this tenant, or a required field could not be mapped to the edge-api DTO. The message names the field.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "EdgePassthrough": {
        "description": "edge-api rejected the call with a 4xx; its status code and body are returned unchanged (shape defined by edge-api).",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true,
              "description": "edge-api error body, passed through verbatim."
            }
          }
        }
      },
      "EdgeError": {
        "description": "`edge-api error`: edge-api answered 5xx.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Retryable: `edge-api unreachable`, `topic resolver unavailable` (DB error) or `topic resolver is not configured`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "requestBodies": {
      "Downtime": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DowntimeRequest"
            }
          }
        }
      },
      "PO": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PORequest"
            }
          }
        }
      },
      "POStop": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/POStopRequest"
            }
          }
        }
      },
      "POSetup": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/POSetupRequest"
            }
          }
        }
      },
      "POReplace": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/POReplaceRequest"
            }
          }
        }
      },
      "POStatus": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/POStatusRequest"
            }
          }
        }
      },
      "POTime": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/POTimeRequest"
            }
          }
        }
      },
      "Split": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SplitRequest"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "OrderNumber": {
        "description": "Client production-order number (ADR-0062): kept as text exactly as given, only surrounding whitespace trimmed. A JSON number keeps its literal text (e.g. 834.058 -> \"834.058\"). null or blank means not supplied.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "OperatorScope": {
        "type": "object",
        "additionalProperties": true,
        "description": "Tenant envelope carried by every action. Unknown fields (Node-RED metadata) are allowed and ignored.",
        "properties": {
          "enterprise": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Must equal the configured enterprise id when present."
          },
          "topic": {
            "type": "string",
            "description": "app_user_topic; audit/debug only."
          },
          "packml_topic": {
            "type": "string",
            "description": "SparkPlug packml_topic; required in practice (422 when empty). Resolved to the tenant's equipment and scope-checked against the configured topic prefix."
          },
          "user": {
            "type": "string",
            "description": "Operator id; audit only, never forwarded or logged."
          }
        }
      },
      "DowntimeRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "id_param",
              "ts_event",
              "ts_end",
              "category",
              "category_desc"
            ],
            "properties": {
              "id_param": {
                "type": "integer",
                "enum": [
                  30810,
                  30811,
                  30812,
                  30813,
                  30814
                ],
                "description": "30810/30811 create; 30812/30813/30814 edit."
              },
              "id_equipment_event": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Event to edit; required for 30812-30814."
              },
              "ts_event": {
                "type": "string",
                "description": "ISO 8601 start."
              },
              "ts_end": {
                "type": "string",
                "description": "ISO 8601 end."
              },
              "category": {
                "type": "string",
                "description": "cd_category."
              },
              "category_desc": {
                "type": "string",
                "description": "desc_category."
              },
              "subcategory": {
                "type": "string"
              },
              "subcategory_desc": {
                "type": "string"
              },
              "txt_downtime": {
                "type": "string",
                "description": "Downtime notes."
              },
              "planned_dwt": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Edit path only."
              },
              "change_over": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Edit path only."
              },
              "idle": {
                "type": "string",
                "description": "Edit path only."
              }
            }
          }
        ]
      },
      "PORequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "id_order",
              "production_order_quantity",
              "timestamp"
            ],
            "properties": {
              "id_order": {
                "$ref": "#/components/schemas/OrderNumber"
              },
              "production_order_quantity": {
                "type": "integer",
                "description": "Programmed quantity."
              },
              "timestamp": {
                "type": "string",
                "description": "`YYYY-MM-DD HH:mm:ss`."
              },
              "nm_production_order": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "id_label": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "POStopRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "timestamp",
              "stop_type",
              "id_production_order",
              "production_order_quantity"
            ],
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "stop_type": {
                "type": "string",
                "description": "`pause` (also `interrupt` or `1`) or `finish` (also `2`); case-insensitive."
              },
              "id_production_order": {
                "type": "integer",
                "description": "Internal id of the running PO."
              },
              "production_order_quantity": {
                "type": "integer",
                "description": "Final good count."
              }
            }
          }
        ]
      },
      "POSetupRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "timestamp",
              "should_open_new_po",
              "stop_type",
              "old_id_production_order",
              "old_production_order_prod_final"
            ],
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "should_open_new_po": {
                "type": "boolean",
                "description": "true = close current and open next; false = close only."
              },
              "stop_type": {
                "type": "string",
                "description": "`pause`/`interrupt`/`1` or `finish`/`2`."
              },
              "old_id_production_order": {
                "type": "integer",
                "description": "PO being closed."
              },
              "old_production_order_prod_final": {
                "type": "integer",
                "description": "Final good count of the PO being closed."
              },
              "should_create_po": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Open-next needs a new PO row."
              },
              "id_order": {
                "$ref": "#/components/schemas/OrderNumber"
              },
              "id_production_order": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Existing next PO (when not creating)."
              },
              "production_order_quantity": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Programmed quantity of the new PO."
              },
              "id_label": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "nm_production_order": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        ]
      },
      "POReplaceRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "id_production_order"
            ],
            "properties": {
              "id_production_order": {
                "type": "integer",
                "description": "PO to switch to."
              }
            }
          }
        ]
      },
      "POStatusRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "id_production_order"
            ],
            "properties": {
              "id_production_order": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "POTimeRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "id_production_order_runtime",
              "id_production_order",
              "start"
            ],
            "properties": {
              "id_production_order_runtime": {
                "type": "integer",
                "description": "Runtime interval to edit."
              },
              "id_production_order": {
                "type": "integer"
              },
              "start": {
                "type": "string",
                "description": "New start."
              },
              "end": {
                "type": "string",
                "description": "New end (optional)."
              }
            }
          }
        ]
      },
      "SplitRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OperatorScope"
          },
          {
            "type": "object",
            "required": [
              "id_equipment_event",
              "event_type",
              "events"
            ],
            "properties": {
              "id_equipment_event": {
                "type": "integer",
                "description": "Event being split."
              },
              "event_type": {
                "type": "string",
                "enum": [
                  "downtime",
                  "manual",
                  "low_speed"
                ]
              },
              "events": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/SplitEvent"
                }
              }
            }
          }
        ]
      },
      "SplitEvent": {
        "type": "object",
        "required": [
          "start_time",
          "category_code",
          "desc_category",
          "idle",
          "change_over",
          "planned_dwt"
        ],
        "properties": {
          "start_time": {
            "type": "string",
            "description": "ISO 8601."
          },
          "end_time": {
            "type": "string",
            "description": "ISO 8601."
          },
          "note": {
            "type": "string"
          },
          "category_code": {
            "type": "string",
            "minLength": 1
          },
          "subcategory_code": {
            "type": "string"
          },
          "desc_category": {
            "type": "string",
            "minLength": 1
          },
          "desc_subcategory": {
            "type": "string"
          },
          "idle": {
            "type": "string",
            "enum": [
              "Yes",
              "yes",
              "No",
              "no"
            ]
          },
          "change_over": {
            "type": "boolean"
          },
          "planned_dwt": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

+import { AuthCognito } from './auth-cognito-dao';
+import { Database } from 'src/providers/database/database.interface';
+
+describe('AuthCognito.resolveBySub (#159 link-on-login guard)', () => {
+  let db: jest.Mocked<Database>;
+  let dao: AuthCognito;
+
+  beforeEach(() => {
+    db = {
+      query: jest.fn(),
+      executeTransactions: jest.fn(),
+      getTransactionsLength: jest.fn(),
+      close: jest.fn(),
+    } as unknown as jest.Mocked<Database>;
+    dao = new AuthCognito(db);
+  });
+
+  it('resolves directly when the sub is already linked (steady state)', async () => {
+    db.query.mockResolvedValueOnce([{ id_enterprise: 42 }]); // existing lookup
+    const out = await dao.resolveBySub('sub-abc', 'a@x.com', true);
+    expect(out).toEqual({ uid: 'sub-abc', idEnterprise: 42 });
+    // Only the existing-lookup query runs; no link UPDATE.
+    expect(db.query).toHaveBeenCalledTimes(1);
+    expect(db.query.mock.calls[0][0]).toContain('id_user_cognito = $1');
+  });
+
+  it('links on first login by verified email (single-row) and returns the tenant', async () => {
+    db.query
+      .mockResolvedValueOnce([]) // not yet linked
+      .mockResolvedValueOnce([{ id_enterprise: 7 }]); // UPDATE ... RETURNING
+    const out = await dao.resolveBySub('sub-new', 'User@X.com', true);
+    expect(out).toEqual({ uid: 'sub-new', idEnterprise: 7 });
+    // The link UPDATE must use the single-row ORDER BY id_user ASC guard.
+    const linkSql = db.query.mock.calls[1][0] as string;
+    expect(linkSql).toContain('UPDATE users');
+    expect(linkSql).toContain('ORDER  BY id_user ASC');
+    expect(linkSql).toContain('LIMIT  1');
+    expect(linkSql).toContain('id_user_cognito IS NULL');
+    // sub + email are the bound params.
+    expect(db.query.mock.calls[1][1]).toEqual(['sub-new', 'User@X.com']);
+  });
+
+  it('refuses to link an unverified email', async () => {
+    db.query.mockResolvedValueOnce([]); // not linked
+    await expect(dao.resolveBySub('sub-x', 'a@x.com', false)).rejects.toThrow(
+      /unverified or missing email/,
+    );
+    // Must NOT attempt the link UPDATE.
+    expect(db.query).toHaveBeenCalledTimes(1);
+  });
+
+  it('refuses to link when no email claim is present', async () => {
+    db.query.mockResolvedValueOnce([]); // not linked
+    await expect(dao.resolveBySub('sub-x', undefined, true)).rejects.toThrow(
+      /unverified or missing email/,
+    );
+    expect(db.query).toHaveBeenCalledTimes(1);
+  });
+
+  it('throws when the email matches no active tenant row', async () => {
+    db.query
+      .mockResolvedValueOnce([]) // not linked
+      .mockResolvedValueOnce([]); // UPDATE ... RETURNING found nothing
+    await expect(dao.resolveBySub('sub-x', 'ghost@x.com', true)).rejects.toThrow(
+      /no active tenant row/,
+    );
+  });
+});
diff --git a/src/data/DAO/auth-middleware/auth-cognito-dao.ts b/src/data/DAO/auth-middleware/auth-cognito-dao.ts
new file mode 100644
index 0000000..05cc67b
--- /dev/null
+++ b/src/data/DAO/auth-middleware/auth-cognito-dao.ts
@@ -0,0 +1,102 @@
+import { Database } from 'src/providers/database/database.interface';
+
+/**
+ * AuthCognito — resolves a verified Cognito subject to its tenant on the LEGACY
+ * `packiot40` DB, with link-on-login self-heal.
+ *
+ * #159 / ADR-0034. This is the DB half of the dual-accept cutover: back4-api,
+ * primary-api, edge-api-prod and read-api all resolve a Cognito `sub` →
+ * id_enterprise the SAME way. The unified match is
+ *   WHERE id_user_cognito = $sub  OR  id_user_firebase = $firebaseUid
+ * but a Cognito token only carries `sub`, so this DAO resolves by
+ * id_user_cognito and, on the user's FIRST Cognito login (sub not yet bound),
+ * links the sub to the row matching the token's VERIFIED email.
+ *
+ * The link is single-row (`ORDER BY id_user ASC LIMIT 1`) — the exact guard read-
+ * api uses (auth_firebase.go linkCognitoSQL). It is what makes the 2 packiot40
+ * duplicate-email collisions safe: the partial-unique index on id_user_cognito
+ * rejects a multi-row link, so without the single-row subselect the sub would
+ * never bind and the user would 401 forever.
+ *
+ * Requires migration `db/migrations/packiot40-cognito-user-id` (adds
+ * users.id_user_cognito + its partial-unique index) to be applied first.
+ */
+export class AuthCognito {
+  private db: Database;
+
+  constructor(db: Database) {
+    this.db = db;
+  }
+
+  /**
+   * Resolve a verified Cognito identity to its tenant, linking the sub on first
+   * login. Throws if the sub cannot be bound to exactly one active tenant row.
+   *
+   * @param sub            the verified Cognito subject (token `sub`)
+   * @param email          the verified email claim (may be undefined)
+   * @param emailVerified  the `email_verified` claim
+   */
+  public async resolveBySub(
+    sub: string,
+    email: string | undefined,
+    emailVerified: boolean,
+  ): Promise<{ uid: string; idEnterprise: number }> {
+    const transactional = false;
+
+    // 1) Already linked → resolve directly (steady state, idempotent).
+    const existing = await this.db.query(
+      `
+        SELECT id_enterprise
+        FROM   users
+        WHERE  id_user_cognito = $1
+          AND  active
+          AND  id_enterprise IS NOT NULL
+        LIMIT 1;
+      `,
+      [sub],
+      transactional,
+    );
+    if (existing[0]) {
+      return { uid: sub, idEnterprise: existing[0].id_enterprise };
+    }
+
+    // 2) First Cognito login → link-on-login by VERIFIED email, single row.
+    // A verified email is mandatory: an unverified/absent email must never be
+    // allowed to seize a tenant row.
+    if (!email || !emailVerified) {
+      throw new Error(
+        'Cognito token has no linkable tenant: unverified or missing email',
+      );
+    }
+
+    // Single-statement atomic bind: the subselect picks the earliest active,
+    // not-yet-linked row for this email; the partial-unique index guarantees at
+    // most one sub per row. RETURNING gives us the tenant in the same round-trip.
+    const linked = await this.db.query(
+      `
+        UPDATE users
+        SET    id_user_cognito = $1
+        WHERE  id_user = (
+                 SELECT id_user
+                 FROM   users
+                 WHERE  lower(user_email) = lower($2)
+                   AND  id_user_cognito IS NULL
+                   AND  active
+                   AND  id_enterprise IS NOT NULL
+                 ORDER  BY id_user ASC
+                 LIMIT  1
+               )
+        RETURNING id_enterprise;
+      `,
+      [sub, email],
+      transactional,
+    );
+    if (linked[0]) {
+      return { uid: sub, idEnterprise: linked[0].id_enterprise };
+    }
+
+    throw new Error(
+      'Cognito token could not be linked: no active tenant row for this email',
+    );
+  }
+}

@@ -0,0 +1,105 @@
+import { UnauthorizedException } from '@nestjs/common';
+
+// Mock aws-jwt-verify so no network/JWKS fetch happens in the enabled path.
+const verifyMock = jest.fn();
+jest.mock('aws-jwt-verify', () => ({
+  CognitoJwtVerifier: {
+    create: jest.fn(() => ({ verify: verifyMock })),
+  },
+}));
+
+import { CognitoStrategy } from './cognito.strategy';
+import { AuthCognito } from '../../data/DAO/auth-middleware/auth-cognito-dao';
+
+describe('CognitoStrategy (#159 dual-accept, dark-by-default)', () => {
+  const daoMock = {
+    resolveBySub: jest.fn(),
+  } as unknown as jest.Mocked<AuthCognito>;
+
+  const OLD_ENV = process.env;
+  afterEach(() => {
+    process.env = OLD_ENV;
+    jest.clearAllMocks();
+  });
+
+  function withEnv(env: Record<string, string | undefined>) {
+    process.env = { ...OLD_ENV, ...env };
+  }
+
+  it('is DARK by default: rejects without touching the DAO when the flag is off', async () => {
+    withEnv({
+      COGNITO_AUTH_ENABLED: undefined,
+      COGNITO_USER_POOL_ID: undefined,
+      COGNITO_CLIENT_ID: undefined,
+    });
+    const strat = new CognitoStrategy(daoMock);
+    await expect(strat.validate('Bearer whatever')).rejects.toBeInstanceOf(
+      UnauthorizedException,
+    );
+    expect(daoMock.resolveBySub).not.toHaveBeenCalled();
+    expect(verifyMock).not.toHaveBeenCalled();
+  });
+
+  it('stays dark if the flag is on but pool/client env is missing', async () => {
+    withEnv({
+      COGNITO_AUTH_ENABLED: 'true',
+      COGNITO_USER_POOL_ID: undefined,
+      COGNITO_CLIENT_ID: undefined,
+    });
+    const strat = new CognitoStrategy(daoMock);
+    await expect(strat.validate('Bearer x')).rejects.toBeInstanceOf(
+      UnauthorizedException,
+    );
+  });
+
+  it('when enabled: verifies the token and resolves the tenant via the DAO', async () => {
+    withEnv({
+      COGNITO_AUTH_ENABLED: 'true',
+      COGNITO_USER_POOL_ID: 'us-east-1_TEST',
+      COGNITO_CLIENT_ID: 'client123',
+    });
+    verifyMock.mockResolvedValueOnce({
+      sub: 'sub-1',
+      email: 'a@x.com',
+      email_verified: true,
+    });
+    (daoMock.resolveBySub as jest.Mock).mockResolvedValueOnce({
+      uid: 'sub-1',
+      idEnterprise: 5,
+    });
+
+    const strat = new CognitoStrategy(daoMock);
+    const out = await strat.validate('Bearer good.jwt.token');
+    expect(out).toEqual({ uid: 'sub-1', idEnterprise: 5 });
+    expect(daoMock.resolveBySub).toHaveBeenCalledWith('sub-1', 'a@x.com', true);
+  });
+
+  it('when enabled: rejects a non-Bearer credential (leaves it for other legs)', async () => {
+    withEnv({
+      COGNITO_AUTH_ENABLED: 'true',
+      COGNITO_USER_POOL_ID: 'us-east-1_TEST',
+      COGNITO_CLIENT_ID: 'client123',
+    });
+    const strat = new CognitoStrategy(daoMock);
+    await expect(strat.validate('some-api-key')).rejects.toBeInstanceOf(
+      UnauthorizedException,
+    );
+    expect(verifyMock).not.toHaveBeenCalled();
+  });
+
+  it('when enabled: a verified token with no resolvable tenant → 401', async () => {
+    withEnv({
+      COGNITO_AUTH_ENABLED: 'true',
+      COGNITO_USER_POOL_ID: 'us-east-1_TEST',
+      COGNITO_CLIENT_ID: 'client123',
+    });
+    verifyMock.mockResolvedValueOnce({ sub: 'sub-2', email_verified: false });
+    (daoMock.resolveBySub as jest.Mock).mockRejectedValueOnce(
+      new Error('unverified or missing email'),
+    );
+    const strat = new CognitoStrategy(daoMock);
+    await expect(strat.validate('Bearer t')).rejects.toBeInstanceOf(
+      UnauthorizedException,
+    );
+  });
+});
diff --git a/src/auth/strategies/cognito.strategy.ts b/src/auth/strategies/cognito.strategy.ts
new file mode 100644
index 0000000..c899093
--- /dev/null
+++ b/src/auth/strategies/cognito.strategy.ts
@@ -0,0 +1,102 @@
+import { Inject, Injectable, UnauthorizedException } from '@nestjs/common';
+import { CognitoJwtVerifier } from 'aws-jwt-verify';
+import { AbstractAuthStrategy, AuthReturn } from './auth.abstract.strategy';
+import { AuthCognito } from '../../data/DAO/auth-middleware/auth-cognito-dao';
+import { AuthCreateUser, AuthUpdateUser } from '../../types/user';
+
+/**
+ * CognitoStrategy — dual-accept Cognito leg for primary-api (#159 / ADR-0034).
+ *
+ * DARK BY DEFAULT. Unless COGNITO_AUTH_ENABLED === 'true' AND the pool/client env
+ * is present, `validate` rejects immediately — the MultiAuthGuard then falls
+ * through to the Firebase / api-key legs exactly as today. Deploying this changes
+ * nothing while front4-prod still issues Firebase tokens.
+ *
+ * When enabled it verifies a Cognito **ID token** (RS256/JWKS, iss + aud + exp
+ * enforced by aws-jwt-verify — the AWS-maintained verifier) and resolves the
+ * tenant server-side via AuthCognito (id_user_cognito + link-on-login), mirroring
+ * the read-api/edge-api contract. It never reads a tenant claim from the token
+ * (the migrate-on-login Lambda does not populate custom:id_enterprise).
+ *
+ * Required env when enabled:
+ *   COGNITO_AUTH_ENABLED=true
+ *   COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX   (the prod packiot-prod pool)
+ *   COGNITO_CLIENT_ID=<front4-prod app client id>
+ */
+@Injectable()
+export class CognitoStrategy extends AbstractAuthStrategy {
+  private readonly enabled: boolean;
+  private readonly verifier: ReturnType<typeof CognitoJwtVerifier.create> | null;
+
+  constructor(
+    @Inject('AuthCognito') private readonly authCognito: AuthCognito,
+  ) {
+    super();
+
+    const userPoolId = process.env.COGNITO_USER_POOL_ID;
+    const clientId = process.env.COGNITO_CLIENT_ID;
+    this.enabled =
+      process.env.COGNITO_AUTH_ENABLED === 'true' &&
+      Boolean(userPoolId) &&
+      Boolean(clientId);
+
+    // Only construct the verifier (which primes a JWKS cache) when actually on.
+    this.verifier = this.enabled
+      ? CognitoJwtVerifier.create({
+          userPoolId: userPoolId as string,
+          tokenUse: 'id', // front4 presents the Cognito ID token as Bearer
+          clientId: clientId as string,
+        })
+      : null;
+  }
+
+  static getStrategyName(): string {
+    return 'cognito';
+  }
+
+  async createUser(_data: AuthCreateUser): Promise<string> {
+    // User lifecycle stays on Firebase / the migrate-on-login Lambda during the
+    // dual-accept window; this strategy only verifies + resolves.
+    throw new Error('createUser not supported by CognitoStrategy');
+  }
+
+  async updateUser(_data: AuthUpdateUser): Promise<AuthReturn> {
+    throw new Error('updateUser not supported by CognitoStrategy');
+  }
+
+  async deleteUser(_uid: string): Promise<AuthReturn> {
+    throw new Error('deleteUser not supported by CognitoStrategy');
+  }
+
+  async validate(authToken: string): Promise<AuthReturn> {
+    // Dark path: reject fast so the guard falls through to the other legs.
+    if (!this.enabled || !this.verifier) {
+      throw new UnauthorizedException('Cognito auth disabled');
+    }
+
+    const [scheme, token] = (authToken || '').split(' ');
+    // Only handle Bearer tokens; anything else is for another strategy.
+    if (!token || scheme.toLowerCase() !== 'bearer') {
+      throw new UnauthorizedException('No bearer token provided');
+    }
+
+    let payload: { sub: string; email?: string; email_verified?: boolean };
+    try {
+      payload = (await this.verifier.verify(token)) as typeof payload;
+    } catch {
+      throw new UnauthorizedException('Invalid or expired Cognito token');
+    }
+
+    try {
+      return await this.authCognito.resolveBySub(
+        payload.sub,
+        payload.email,
+        payload.email_verified === true,
+      );
+    } catch {
+      // Verified token but no resolvable/ linkable tenant → 401 (same shape as
+      // the other legs; the guard will report a generic auth failure).
+      throw new UnauthorizedException('Cognito token could not resolve a tenant');
+    }
+  }
+}

# edge-ssm.env.example — the SSM Hybrid-Activation handoff (ADR-0049).
#
# Copy to `edge-ssm.env`, fill the three values, and install it at
# /opt/packiot/edge-ssm.env (0600). ssm-register.service loads it via
# EnvironmentFile and ssm-register.sh enrolls this box as a `mi-xxxx` managed
# instance on first boot.
#
#   cp edge-ssm.env.example edge-ssm.env && $EDITOR edge-ssm.env
#   sudo install -m600 edge-ssm.env /opt/packiot/edge-ssm.env
#
# These are minted per-box by CS-Admin (edge-api POST /api/edge-ssm/activation)
# and handed off through the SAME secure channel as the mTLS client key — NEVER
# committed (edge-ssm.env is gitignored). The activation CODE is returned ONCE by
# AWS at mint time and is NOT re-retrievable — if lost, mint a new activation.
#
# Keep these lines clean KEY=VALUE with NO trailing comments — systemd's
# EnvironmentFile parser does not strip inline `#`.

SSM_ACTIVATION_CODE=REPLACE_WITH_ACTIVATION_CODE
SSM_ACTIVATION_ID=REPLACE_WITH_ACTIVATION_ID
SSM_REGION=us-east-1

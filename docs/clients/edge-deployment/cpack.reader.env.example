# cpack.reader.env — CPACK edge deploy on the READER path (compose.edge.yml,
# ADR-0042 Mode-B, ADR-0045 config-as-data Tier-1).
# Copy → .env on the CPACK edge host, fill the SECRETS, then:
#   docker compose --profile reader -f compose.edge.yml --env-file .env up -d
#
# THIS IS THE NO-NODE-RED PATH. Go PLC readers (s7 | modbus | opcua) poll the
# factory PLCs and publish RAW tags to the internal mosquitto; the sparkplug-agent
# consumes them, builds SparkPlug B, and uplinks over mTLS to new-prod. There is
# NO tee, NO HTTP ingest key on the wire, NO localhost cloud URL.
#
# MULTI-PLC, MIXED-PROTOCOL (ADR-0045): each protocol reader drives EVERY endpoint
# of its protocol in client.yaml (one poller per PLC). CPACK = 9 S7 + 1 Modbus →
# the s7-reader drives all nine S7 cells, the modbus-reader drives the packer, the
# opcua-reader finds nothing and self-retires. No per-endpoint service to define.
# See README-reader.md for the full runbook.

# ── TENANT IDENTITY ───────────────────────────────────────────────────────────
TENANT_SLUG=cpack                       # lowercase; names containers + edge/raw/<tenant>
TENANT_UPPER=CPACK                      # SparkPlug group_id / enterprise short-name (UPPER)

# ── PROFILE SELECTION ─────────────────────────────────────────────────────────
# `reader` is the umbrella profile: it starts all three protocol readers; the ones
# with no endpoints in client.yaml exit 0 (nothing to drive). To start only the
# protocols you use, set e.g. COMPOSE_PROFILES=reader-s7,reader-modbus instead.
COMPOSE_PROFILES=reader

# ── READER SELECTION ──────────────────────────────────────────────────────────
# Leave READER_ENDPOINT EMPTY to drive ALL of each protocol's endpoints (the
# multi-PLC model). Set it to a plc.endpoints[].name to pin a SINGLE endpoint
# (only the reader whose protocol owns that endpoint drives it; the others idle).
READER_ENDPOINT=

MQTT_BROKER_URL=tcp://mosquitto:1883    # internal loopback bus (default; rarely changed)

# ── PLC HOST SECRETS (deploy-provisioned; never committed) ────────────────────
# Per-endpoint override PLC_HOST_<NAME> (NAME = plc.endpoints[].name upper-cased,
# non-alphanumerics → '_') gives each PLC its own host — the multi-PLC path. A
# generated bundle appends one blank line per driven endpoint; fill each:
#   PLC_HOST_CELULA1=10.0.0.10:102        # s7 cell 1
#   PLC_HOST_CELULA2=10.0.0.11:102        # s7 cell 2  ... (nine S7 cells)
#   PLC_HOST_PACKER1=10.0.0.30:502        # modbus packer
#
# Protocol-wide FALLBACK (used when an endpoint has no PLC_HOST_<NAME>): handy for
# a single-endpoint client. s7: host[:102] | modbus: host:502 | opcua: full URL.
# S7_HOST=10.0.0.10:102
# MODBUS_HOST=10.0.0.11:502
# OPCUA_ENDPOINT_URL=opc.tcp://10.0.0.12:4840

# ── IMAGES ────────────────────────────────────────────────────────────────────
# The reader uses the MAIN sparkplug-decoder Dockerfile (ships the reader binaries).
# AGENT_IMAGE drives BOTH the reader and the agent service image here; pin the
# released multi-arch artifact, or leave :local to `docker compose build`.
AGENT_IMAGE=packiot/sparkplug-agent:local

# ── GENERATED ARTIFACT PATHS (onboard-gen output for THIS tenant) ─────────────
CLIENT_CONFIG_FILE=./cpack/cpack-client.yaml    # (GENERATED, artifact 5) reader endpoints + tag maps
AGENT_CONFIG_FILE=./cpack/cpack-agent.yaml      # (GENERATED) agentcfg descriptor
AGENT_PROFILE_FILE=./cpack/cpack-profile.yaml   # (GENERATED) tenant conversion profile

# ── mTLS UPLINK TO NEW-PRODUCTION (ADR-0042 §6) ───────────────────────────────
# (PROVISIONED) resolve the generated agent.yaml secret:// refs into ./certs/.
# ⚠️ After placing uplink-key.pem, hand it to the agent's NON-ROOT uid 65532 or
#    the agent crash-loops on the TLS key load (CPACK bring-up bug):
#        sudo chown 65532:65532 ./certs/uplink-key.pem   # (or: sudo chmod 0644)
CERTS_DIR=./certs
AGENT_UPLINK_TLS_CERT=/etc/packiot/certs/uplink-cert.pem
AGENT_UPLINK_TLS_KEY=/etc/packiot/certs/uplink-key.pem
AGENT_UPLINK_CA=/etc/packiot/certs/uplink-ca.pem

# ── HTTP INGEST FRONT-DOOR — OFF on the reader path ───────────────────────────
# The reader feeds the agent over MQTT, so the HTTP tee front-door is unused.
# Disable it. AGENT_INGEST_API_KEY is still REQUIRED by compose interpolation
# (the agent + nodered service definitions guard it with `:?`), so set a non-empty
# placeholder — it is never put on any wire when ingest is disabled.
AGENT_HTTP_INGEST_ENABLED=false
AGENT_INGEST_API_KEY=unused-on-reader-path-http-ingest-disabled

# ── CUTOVER FLAGS ─────────────────────────────────────────────────────────────
# MUST stay false at the edge: the register-driven tag map needs the cloud DB
# (packml_register), which the factory edge cannot reach — turning it on
# crash-loops the agent (CPACK bring-up bug). Flip ON only in a Mode-A staging
# harness that has DB reachability, never on a real client edge.
AGENT_TAGMAP_FROM_REGISTER=false
AGENT_PARAM_DECOMPOSITION=false

# ── PORTS / MISC ──────────────────────────────────────────────────────────────
AGENT_HEALTH_PORT=9103                  # host port for /healthz + /metrics
LOG_LEVEL=info
TZ=UTC

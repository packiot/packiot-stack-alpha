# .env.template — per-client parameters for the Mode-B edge bundle (compose.edge.yml).
#
# Copy to `.env` and fill for the tenant being deployed:
#     cp .env.template .env && $EDITOR .env
# The values marked (GENERATED) come from the onboard-gen artifact set; the ones
# marked (PROVISIONED) come from the cert/secret provisioning step (see README).
# NEVER commit a filled .env or any cert — ./.gitignore excludes them.

# ── TENANT IDENTITY ───────────────────────────────────────────────────────────
TENANT_SLUG=bispharma                 # lowercase; names containers + the compose project
TENANT_UPPER=BISPHARMA                # SparkPlug group_id / enterprise short-name (UPPER)

# ── IMAGES ────────────────────────────────────────────────────────────────────
# AGENT_IMAGE: the PINNED released agent (registry/sparkplug-agent:<semver>,
# multi-arch amd64+arm64). Leave as :local to build from Dockerfile.agent instead.
AGENT_IMAGE=packiot/sparkplug-agent:local
NODERED_IMAGE=nodered/node-red:4.0    # or the client's edge-node-red image

# ── GENERATED ARTIFACT PATHS (onboard-gen output for THIS tenant) ─────────────
AGENT_CONFIG_FILE=./bispharma/bispharma-agent.yaml       # (GENERATED) agentcfg descriptor
AGENT_PROFILE_FILE=./bispharma/bispharma-profile.yaml    # (GENERATED) tenant conversion profile
NODERED_FLOWS_DIR=./bispharma/nodered                    # client connectivity flows + imported tee

# ── INGEST AUTH (the tee → agent HTTP front-door) ─────────────────────────────
# (PROVISIONED) shared secret the Node-RED tee sends as X-Ingest-Key. Generate a
# strong random value; hand the SAME value to the tee via ${TENANT_UPPER}_INGEST_KEY.
AGENT_INGEST_API_KEY=CHANGE-ME-strong-random-key
AGENT_HTTP_INGEST_ENABLED=true

# ── mTLS UPLINK TO NEW-PRODUCTION (ADR-0042 §6) ───────────────────────────────
# (PROVISIONED) the per-tenant client cert (CN=<TENANT_UPPER>) + the CA that
# signs the cloud broker's SERVER cert. Resolve the secret:// refs in the
# generated agent.yaml into these files under ./certs/ (gitignored) at deploy.
# The uplink_broker itself (ssl://…:8883) lives in the generated agent.yaml.
CERTS_DIR=./certs
AGENT_UPLINK_TLS_CERT=/etc/packiot/certs/uplink-cert.pem
AGENT_UPLINK_TLS_KEY=/etc/packiot/certs/uplink-key.pem
AGENT_UPLINK_CA=/etc/packiot/certs/uplink-ca.pem

# ── CUTOVER FLAGS (ADR-0043/0044) — default OFF; flip only when VALIDATE green ──
AGENT_TAGMAP_FROM_REGISTER=false      # ON = build tag map from packml_register + profile
AGENT_PARAM_DECOMPOSITION=false       # ON = id-driven bare-Parameter → Parameter30700

# AGENT_BIRTH_ALL_MAPPED — default ON (both the agent binary and compose.edge.yml
# default this true; 2026-08-20 red-team fix). NOT a cutover flag like the two
# above: it is a safety net, not a DB-dependent behavior change, so it ships ON
# for every client. ON = birth the FULL raw_tag_map so an idle-at-connect line
# still gets a stable alias — fixes the sparse-line NDATA drop that took CPACK
# dark on 2026-08-13 (root cause: agent only aliased tags it had SEEN by the
# time it birthed, so a sparse line idle since the last restart was never
# re-aliased and its data silently vanished forever). Set to `false` only to
# deliberately reproduce the pre-fix behaviour (e.g. regression testing).
AGENT_BIRTH_ALL_MAPPED=true

# ── SSM HYBRID ACTIVATION (ADR-0049) — the register-on-boot substrate ─────────
# (PROVISIONED) The box enrolls itself as an AWS SSM managed instance on first
# boot so CS-Admin can push deploys (RunCommand) + reach it (Session Manager),
# OUTBOUND 443 only. These activation values are minted per-box by CS-Admin
# (edge-api POST /api/edge-ssm/activation) and handed off through the SAME secure
# channel as the mTLS key. They do NOT live here — keep them in the dedicated,
# gitignored `edge-ssm.env` (see edge-ssm.env.example) that ssm-register.service
# reads, so systemd's EnvironmentFile parser gets clean KEY=VALUE lines. See
# README §5.5. Leave edge-ssm.env absent to skip SSM registration entirely.

# ── PORTS / MISC ──────────────────────────────────────────────────────────────
AGENT_HEALTH_PORT=9103                # host port for /healthz + /metrics
NODERED_UI_PORT=1880                  # bind to a LAN/VPN interface in production
LOG_LEVEL=info
TZ=UTC

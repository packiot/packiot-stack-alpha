# cpack.env — CPACK controlled edge deploy (compose.edge.yml, ADR-0042 Mode-B).
# Copy → .env next to compose.edge.yml on the CPACK edge host, fill the SECRET.
# This deploys a NEW, PARALLEL Node-RED + sparkplug-agent at CPACK that co-tees
# the PLCs (read-only) → new-production ingest. The LEGACY CPACK Node-RED is
# NOT touched.

TENANT_SLUG=cpack                       # container/project name
TENANT_UPPER=CPACK                      # SparkPlug group_id / enterprise short-name
AGENT_IMAGE=packiot/sparkplug-agent:local
NODERED_IMAGE=nodered/node-red:4.0

# GENERATED bundle (onboard-gen output, committed under ./cpack/)
AGENT_CONFIG_FILE=./cpack/cpack-agent.yaml
AGENT_PROFILE_FILE=./cpack/cpack-profile.yaml
NODERED_FLOWS_DIR=./cpack/nodered       # PLC I/O flows + the imported cpack-tee-node.json

# ── DATA PATH (Mode-B, ADR-0042 §6) ───────────────────────────────────────────
# Node-RED tee → LOCAL agent (POST http://localhost:9104/v1/tags) → the agent
# builds SparkPlug B and UPLINKS over mTLS to new-prod's mosquitto :8883. The
# cloud broker host lives in cpack-agent.yaml (uplink_broker: ssl://…:8883); the
# tee is localhost, so nothing here points at the cloud.
#
# AGENT_INGEST_API_KEY = the LOCAL tee↔agent shared secret (the agent's :9104
# X-Ingest-Key). compose.edge.yml hands the SAME value to the tee as
# CPACK_INGEST_KEY. It is NOT a cloud key. The Client Edge Deploy workflow injects
# it from a GitHub secret at deploy time — leave the placeholder; do NOT commit it.
AGENT_INGEST_API_KEY=SET-BY-WORKFLOW-local-tee-agent-secret
AGENT_HTTP_INGEST_ENABLED=true

# ── mTLS uplink material (Mode-B, CN=cpack) — PROVISION on the edge host ───────
# Put the CPACK client cert/key + the CA (from gen-mtls-certs.sh) at CERTS_DIR as
# uplink-cert.pem / uplink-key.pem / uplink-ca.pem BEFORE firing (the workflow
# fails closed if they're missing). ssl:// + these files ⇒ real mTLS; without them
# the agent would warn + downgrade to plaintext, which mosquitto :8883 refuses.
CERTS_DIR=./certs
AGENT_UPLINK_TLS_CERT=/etc/packiot/certs/uplink-cert.pem
AGENT_UPLINK_TLS_KEY=/etc/packiot/certs/uplink-key.pem
AGENT_UPLINK_CA=/etc/packiot/certs/uplink-ca.pem

AGENT_TAGMAP_FROM_REGISTER=true         # build tag map from packml_register (SEEDED on new-prod) + profile
AGENT_PARAM_DECOMPOSITION=false
AGENT_HEALTH_PORT=9103
NODERED_UI_PORT=1880                     # bind to a LAN/VPN interface only in production
LOG_LEVEL=info
TZ=UTC

# cpack.env — CPACK controlled edge deploy (compose.edge.yml, ADR-0042 Mode-B).
# Copy → .env next to compose.edge.yml on the CPACK edge host, fill the SECRET.
# This deploys a NEW, PARALLEL Node-RED + sparkplug-agent at CPACK that co-tees
# the PLCs (read-only) → new-production ingest. The LEGACY CPACK Node-RED is
# NOT touched.

TENANT_SLUG=cpack                       # container/project name
TENANT_UPPER=CPACK                      # SparkPlug group_id / enterprise short-name
AGENT_IMAGE=packiot/sparkplug-agent:local
NODERED_IMAGE=nodered/node-red:4.0

# GENERATED bundle (onboard-gen output, committed under ./cpack/)
AGENT_CONFIG_FILE=./cpack/cpack-agent.yaml
AGENT_PROFILE_FILE=./cpack/cpack-profile.yaml
NODERED_FLOWS_DIR=./cpack/nodered       # PLC I/O flows + the imported cpack-tee-node.json

# ── new-prod ingest (the target of this controlled deploy) ────────────────────
# DATA PATH (as built): the CPACK Node-RED tee POSTs SparkPlug-JSON over HTTPS to
# new-production's ingest-shim, which republishes onto RabbitMQ (sparkplug.data)
# → oeecloud-worker/edge-transformer → F3. The shim is LIVE + healthy on:
#   https://ec2-3-232-9-118.compute-1.amazonaws.com:8444/ingest/sparkplug
#   (new-prod app node — Elastic IP 3.232.9.118, stable; shim HTTP_ADDR=:8444)
# ⚠ port is :8444 on PROD (:8446 is staging) — the workflow re-seds host+port per
# target, so leave the committed default at the prod value.
# AGENT_INGEST_API_KEY = the shim's X-Ingest-Key. It MUST equal new-prod's
# INGEST_API_KEY (in /opt/packiot/.env on i-02d255a1c21fb1da3). The Client Edge
# Deploy workflow injects it from the PRODUCTION_INGEST_API_KEY GitHub secret at
# deploy time — so leave the placeholder here; do NOT commit the real key.
AGENT_INGEST_API_KEY=SET-BY-WORKFLOW-FROM-PRODUCTION_INGEST_API_KEY
AGENT_HTTP_INGEST_ENABLED=true

# ── mTLS uplink (Mode-B, CN=cpack) — NOT in the active data path yet ──────────
# The compose.edge.yml agent still starts, but the tee above bypasses it (it POSTs
# straight to the cloud shim). The agent+outbox mTLS :8883 durability path is a
# TRACKED FOLLOW-UP (needs the cloud mosquitto :8883 listener + certs + tee rewire);
# these vars are pre-wired so flipping to it later is config-only. Left unset today
# ⇒ agent uplink stays Mode-A (harmless; not on the CPACK data path).
CERTS_DIR=./certs
AGENT_UPLINK_TLS_CERT=/etc/packiot/certs/uplink-cert.pem
AGENT_UPLINK_TLS_KEY=/etc/packiot/certs/uplink-key.pem
AGENT_UPLINK_CA=/etc/packiot/certs/uplink-ca.pem

AGENT_TAGMAP_FROM_REGISTER=true         # build tag map from packml_register (SEEDED on new-prod) + profile
AGENT_PARAM_DECOMPOSITION=false
AGENT_HEALTH_PORT=9103
NODERED_UI_PORT=1880                     # bind to a LAN/VPN interface only in production
LOG_LEVEL=info
TZ=UTC

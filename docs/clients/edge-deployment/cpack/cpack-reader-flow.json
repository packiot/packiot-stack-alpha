  {
    "finalize": "",
    "func": "// CPACK PLC reader → sparkplug-agent — generated from the descriptor plc: block.\n// DUMB producer: emits raw tags (metric = canonical suffix); the agent maps them.\n// Override the agent ingest URL with env CPACK_AGENT_URL (default http://sparkplug-agent:9104/v1/tags).\n// The ingest key is read from env AGENT_INGEST_API_KEY — NEVER hardcoded.\n\nconst url = env.get(\"CPACK_AGENT_URL\") || \"http://sparkplug-agent:9104/v1/tags\";\nconst key = env.get(\"AGENT_INGEST_API_KEY\");\nif (!key) {\n    node.error(\"AGENT_INGEST_API_KEY env var is not set — refusing to POST without an ingest key\", msg);\n    return null;\n}\n// The agent's raw_tag_map is keyed by the canonical SUFFIX (topic minus the\n// tenant prefix). Source-node names carry the FULL canonical topic, so strip\n// the prefix here to match the map — otherwise every tag is dropped unmapped.\nconst PREFIX = \"CPACK/SC\";\nfunction suffix(n) { return (n \u0026\u0026 n.indexOf(PREFIX) === 0) ? n.slice(PREFIX.length) : n; }\nconst ts = Date.now();\nconst tags = [];\nconst MB_WS = {\"CPACK/SC/LINHAS/L6/BREYER/Admin/ProdConsumedCount/91/Unit\":1,\"CPACK/SC/LINHAS/L6/POLYTYPE/Admin/ProdConsumedCount/93/Unit\":1,\"CPACK/SC/LINHAS/L6/PTH/Admin/ProdConsumedCount/95/Unit\":1,\"CPACK/SC/LINHAS/L6/PTH/Admin/ProdProcessedCount/95/Unit\":1,\"CPACK/SC/LINHAS/L6/RMH/Admin/ProdConsumedCount/94/Unit\":1,\"CPACK/SC/LINHAS/L6/RMH/Admin/ProdProcessedCount/94/Unit\":1,\"CPACK/SC/LINHAS/L6/TEXA/Admin/ProdConsumedCount/92/Unit\":1,\"CPACK/SC/LINHAS/L6/TEXA/Admin/ProdProcessedCount/92/Unit\":1,};\nconst p = msg.payload;\nif (p \u0026\u0026 typeof p === \"object\" \u0026\u0026 !Array.isArray(p)) {\n    // S7 \"all\" mode: { canonicalTopic: value, … } — one tag per numeric entry.\n    for (const k of Object.keys(p)) {\n        const v = p[k];\n        if (typeof v === \"number\" \u0026\u0026 isFinite(v)) tags.push({ metric: suffix(k), value: v, ts: ts });\n    }\n} else if (Array.isArray(p) \u0026\u0026 msg.topic) {\n    // Modbus read: 1 register = 16-bit; 2 registers = 32-bit totalizer.\n    // word_swap (MB_WS) ⇒ low word first (CDAB); else high word first (ABCD).\n    // Use *65536 (not \u003c\u003c16) to stay in float and avoid 32-bit sign overflow.\n    let v;\n    if (p.length \u003e= 2) { v = MB_WS[msg.topic] ? (p[1]*65536 + p[0]) : (p[0]*65536 + p[1]); }\n    else { v = Number(p[0]); }\n    if (isFinite(v)) tags.push({ metric: suffix(msg.topic), value: v, ts: ts });\n} else if (typeof p === \"number\" \u0026\u0026 isFinite(p)) {\n    // OPC-UA (or any scalar) read: identity on msg.topic / msg.name.\n    const name = msg.topic || msg.name;\n    if (name) tags.push({ metric: suffix(name), value: p, ts: ts });\n}\n\nif (tags.length === 0) {\n    node.warn(\"reader: no numeric tags in this message; skipping\");\n    return null;\n}\n\nmsg.url = url;\nmsg.headers = { \"Content-Type\": \"application/json\", \"X-Ingest-Key\": key };\nmsg.payload = { endpoint: \"cpack-edge\", scan_ts: ts, tags: tags };\nreturn msg;\n",
    "id": "cpack_reader_norm",

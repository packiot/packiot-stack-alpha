.env.local

# Terraform plan files — never committed (contain credentials and rapidly stale)
terraform/staging/tfplan*
terraform/staging/*.tfplan
terraform/production/tfplan*
terraform/production/*.tfplan

# Python bytecode (simulator + any future Python tooling)
__pycache__/
*.pyc

# Node dependencies — any service's installed deps (e.g. services/cognito-user-migration).
# Never committed; restored via `npm ci`.
node_modules/

# LaTeX / Pandoc presentation build artifacts.
# `presentation/` is a working scratch dir for slide decks; not part of the stack.
presentation/

# Stray shell-expansion accidents — keep these patterns ignored so a bad
# `grep -o '{print …'` or `aws … --query '{{.Destination}}…'` doesn't get
# re-committed. Cleaned up in the 2026-06-24 decommission PR.
0{print
{{.Destination}}*
monitoring/alertmanager/slack_api_url

# RabbitMQ definitions generated at deploy from the template + Secrets Manager (has passwords)
monitoring/rabbitmq/definitions.json

# ── Secret-material hardening (task #61) ──────────────────────────────────────
# Belt-and-suspenders alongside the gitleaks gate: keep credential-bearing file
# shapes out of the index entirely so they can never reach a remote.
# NOTE: gitignore has no trailing comments: `#` starts a comment only at the
# start of a line. Until 2026-10-06 these seven rules had end-of-line comments,
# so each line was one literal pattern that matched nothing (nothing ignored).
# Real env files (.env.local already ignored above)
.env
# TLS / SSH private keys
*.pem
# OpenVPN client configs (embed inline keys/certs)
*.ovpn
# Terraform variable files (DB passwords, tokens)
*.tfvars
# GCP service-account key files
*service-account*.json
# Generic exported private keys
private-key.json
# OAuth client secret bundles
client_secrets.json
db/migrations/**/_ssm.json

# wiki build outputs (scripts/build-wiki.sh)
wiki/build/
dist/

{
  "rabbit_version": "3.13.7",
  "users": [
    { "name": "__ADMIN__", "password": "__ADMIN_PASS__", "tags": ["administrator"] },
    { "name": "stream-engine", "password": "__OEE_PASS__", "tags": [] },
    { "name": "sparkplug-decoder", "password": "__SD_PASS__", "tags": [] }
  ],
  "vhosts": [{ "name": "/" }],
  "permissions": [
    { "user": "__ADMIN__", "vhost": "/", "configure": ".*", "write": ".*", "read": ".*" },
    {
      "user": "stream-engine", "vhost": "/",
      "configure": "^(oee|oee-retry|oee-failed|stream-engine-q.*|oeecloud-fanout.*)$",
      "write": "^(oee|oee-retry|oee-failed|stream-engine-q.*|oeecloud-fanout.*)$",
      "read": "^(oee|oee-retry|oee-failed|stream-engine-q.*|oeecloud-fanout.*)$"
    },
    {
      "user": "sparkplug-decoder", "vhost": "/",
      "configure": "^(edge-transformer.*|outbox.*|edge\\.plc-normalized.*|dlx\\.edge\\.plc-normalized.*)$",
      "write": "^(edge-transformer.*|outbox.*|edge\\.plc-normalized.*|oee)$",
      "read": "^(edge\\.plc-normalized.*|dlx\\.edge\\.plc-normalized.*|edge-transformer.*|outbox.*|oee)$"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [],
  "policies": [],
  "queues": [],
  "exchanges": [],
  "bindings": []
}

{
  "name": "packiot-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-frontend Playwright E2E suite — front4, operator, csadmin, customize against staging.",
  "scripts": {
    "test": "playwright test",
    "test:front4": "playwright test --project=front4",
    "test:operator": "playwright test --project=operator",
    "test:csadmin": "playwright test --project=csadmin",
    "test:customize": "playwright test --project=customize",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5"
  }
}

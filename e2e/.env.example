# Copy to .env and fill. Nothing here is committed (.env is gitignored).

# --- deployed frontend URLs (staging) ---
FRONT4_URL=https://staging.packiot.com
OPERATOR_URL=https://operator.staging.packiot.app
CSADMIN_URL=https://csadmin.staging.packiot.app
CUSTOMIZE_URL=https://customize.staging.packiot.app

# --- front4 product login (Cognito email/password form) ---
# A generic staging product user (any tenant) — proves the SPA renders + auths.
FRONT4_USER=0001_os2@packiot.com
FRONT4_PASSWORD=

# A cs-admin / super_user account (dev@packiot.com) for the cpack (ent 3) switch
# assertion — OR a dedicated ent-3 user. Leave blank to skip the cpack data test.
CPACK_USER=
CPACK_PASSWORD=
CPACK_ENTERPRISE_ID=3

# --- operator (Cognito) ---
OPERATOR_USER=
OPERATOR_PASSWORD=

# --- csadmin / customize (Cognito via oauth2-proxy / cs-admin group) ---
CSADMIN_USER=
CSADMIN_PASSWORD=

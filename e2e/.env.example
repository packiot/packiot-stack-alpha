# Copy to .env and fill, OR run `npm run creds` to populate it from AWS Secrets
# Manager (packiot/staging/e2e-test-creds — the scalable per-client source of
# truth). Nothing here is committed (.env is gitignored).
#
# All staging frontends authenticate against ONE Cognito pool (us-east-1_0T9t1sTwt):
#   - front4  → in-app amplify form (app-client 2ckuoa0ov598rdpdn3uv039h6e)
#   - operator/csadmin/customize → oauth2-proxy → shared Cognito Hosted UI
#     (app-client 4g5j94vsodtt8g8ima2hnf8ke7 "oauth2-proxy-staging")
# So one Cognito user works everywhere; the difference is (a) tenant link in the
# users tables and (b) cs-admin group membership for the platform consoles.

# --- deployed frontend URLs (staging) ---
FRONT4_URL=https://staging.packiot.com
OPERATOR_URL=https://operator.staging.packiot.app
CSADMIN_URL=https://csadmin.staging.packiot.app
CUSTOMIZE_URL=https://customize.staging.packiot.app

# --- cpack client (ent 3) — one dedicated QA user serves front4 + operator ---
# qa-cpack-staging@packiot.com is linked to ent 3 in BOTH users tables
# (packiot.users + packiot_analytics.identity.users on id_user_cognito).
# To add another client: onboard a qa-<client>-staging user the same way and add
# a clients.<slug> block to the secret (see README "Adding a client").
FRONT4_USER=qa-cpack-staging@packiot.com
FRONT4_PASSWORD=
CPACK_USER=qa-cpack-staging@packiot.com
CPACK_PASSWORD=
CPACK_ENTERPRISE_ID=3
OPERATOR_USER=qa-cpack-staging@packiot.com
OPERATOR_PASSWORD=

# --- platform CS-Admin console (cross-tenant, cs-admin group) ---
# qa-csadmin-staging@packiot.com is in the cs-admin Cognito group; serves both
# the csadmin and customize consoles (customize is a csadmin clone).
CSADMIN_USER=qa-csadmin-staging@packiot.com
CSADMIN_PASSWORD=
CUSTOMIZE_USER=qa-csadmin-staging@packiot.com
CUSTOMIZE_PASSWORD=

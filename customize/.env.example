# ─────────────────────────────────────────────────────────────────────────────
# Backend — edge-api (ADR-0026 write/control plane + topology reads)
# Host root; every route already carries its own /api/... prefix.
# Staging: https://edge-dev.api4.packiot.com
# ─────────────────────────────────────────────────────────────────────────────
VITE_EDGE_API_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Firebase (legacy IdP, default path).
# edge-api runs a dual Firebase/Cognito verifier (ADR-0033), so either token is
# accepted — CS Admin can migrate independently of the other clients.
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Auth — Cognito (go-forward IdP, ADR-0034). ADDITIVE + DARK BY DEFAULT.
# Nothing runs unless VITE_AUTH_COGNITO_ENABLED=true AND both ids are set.
# Pool id + app-client id are PUBLIC (a public SPA app-client has no secret);
# still env-sourced so dev/staging/prod stay separable. Amplify derives the
# region from the pool id (us-east-1_xxxx), so no region var is needed.
# Values below are the STAGING pool (front4 / ADR-0034).
# ─────────────────────────────────────────────────────────────────────────────
VITE_AUTH_COGNITO_ENABLED=false
VITE_COGNITO_USER_POOL_ID=us-east-1_0T9t1sTwt
VITE_COGNITO_CLIENT_ID=2ckuoa0ov598rdpdn3uv039h6e
